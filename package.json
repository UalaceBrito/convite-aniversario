{
  "name": "convite-aniversario",
  "version": "1.0.0",
  "description": "Convite digital interativo para aniversário — projeto acadêmico de desenvolvimento web de nível expert.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "author": {
    "name": "[SEU NOME]",
    "email": "aniversario@exemplo.com",
    "url": "https://exemplo.com"
  },
  "license": "MIT",
  "keywords": [
    "convite",
    "aniversario",
    "pwa",
    "acessibilidade",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint \"src/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "playwright test tests/a11y",
    "optimize:img": "node scripts/optimize-images.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "lighthouse": "lhci autorun --config=scripts/lighthouse-budget.json",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.44.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.11",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.2.5",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ]
}
